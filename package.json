{
  "name": "riftball",
  "version": "1.0.4",
  "description": "RIFTBALL - competitive 3v3 mobile game by SuperEssence",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:long": "RIFT_LONG=1 vitest run tests/unit/longrun.test.ts",
    "test:e2e": "playwright test",
    "android:sync": "npm run build && npx cap sync android",
    "android:debug": "bash scripts/build-android.sh debug",
    "android:release": "bash scripts/build-android.sh release",
    "server:build": "esbuild server/src/main.ts --bundle --platform=node --format=esm --target=node20 --outfile=server/dist/riftball-game.mjs --banner:js=\"import { createRequire as __cr } from 'module'; const require = __cr(import.meta.url);\" --external:bufferutil --external:utf-8-validate",
    "server:start": "npm run server:build && node server/dist/riftball-game.mjs",
    "dev:online": "VITE_SERVER_URL=http://localhost:8787 vite"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julienots/RIFTBALL.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/julienots/RIFTBALL/issues"
  },
  "homepage": "https://github.com/julienots/RIFTBALL#readme",
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/three": "^0.170.0",
    "@types/ws": "^8.18.2",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.9",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/preferences": "^7.0.4",
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "three": "^0.170.0",
    "ws": "^8.22.0"
  },
  "private": true,
  "type": "module"
}
